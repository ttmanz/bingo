# Copy this file to `.env` and set strong, unique values. `.env` is gitignored.
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# JWT signing secrets — REQUIRED. The server refuses to start if any are missing.
JWT_SECRET=
AGENT_JWT_SECRET=
USER_JWT_SECRET=

# Password gating the admin "System Tickets / Give Win" panel (server-enforced).
SYS_TICKETS_PASS=

# Optional — defaults to 3001
# PORT=3001
